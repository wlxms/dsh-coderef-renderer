{
  "name": "dsh-coderef-renderer",
  "version": "0.1.0",
  "private": true,
  "description": "DSH prototype: shadow the assistant Markdown renderer with a local fork of the native MarkdownText pipeline, adding coderef chips for inline code, bold references and coderef: links.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "test": "node test/smoke.mjs"
  },
  "license": "MIT"
}
